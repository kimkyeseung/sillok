# Supabase (로컬 개발도 운영 프로젝트를 씀)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key          # 서버 전용 — 절대 클라이언트 노출 금지

# 앱
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Drafts — 어드민 밈·번역·짧은 소설 생성 (서버 전용)
ANTHROPIC_API_KEY=

# 유물 지도 (MapTiler — 대시보드에서 허용 origin 제한)
NEXT_PUBLIC_MAPTILER_KEY=

# 외부 AI 인물 등록 API (/api/ai/persons, X-API-Key 헤더)
AI_API_SECRET_KEY=

# 초상화 생성 스크립트 (scripts/generate-portraits.mjs)
# OPENAI_API_KEY=

# 소셜 로그인(Google, Discord)은 Supabase Auth 대시보드에서 설정 — 앱 환경 변수 불필요

# Milestone 2 (미사용)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
